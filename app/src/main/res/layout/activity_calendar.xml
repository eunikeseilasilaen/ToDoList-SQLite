<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FC"
    android:padding="20dp">

    <Button
        android:id="@+id/btnCalendarBack"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="‹  Back"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#315D9B" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Calendar"
        android:textColor="#172B4D"
        android:textSize="27sp"
        android:textStyle="bold"
        android:layout_marginTop="22dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose a date to see your tasks."
        android:textColor="#71809A"
        android:textSize="14sp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="15dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="10dp">

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:showWeekNumber="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tasks on selected date"
        android:textColor="#172B4D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvEmptyCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada tugas pada tanggal ini."
        android:textColor="#71809A"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvCalendarTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E9EDF4"
        android:dividerHeight="8dp"
        android:background="@android:color/transparent" />

</LinearLayout>
