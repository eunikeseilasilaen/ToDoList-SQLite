
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FC"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- HEADER LOGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgWelcomeLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_bear_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="ToDoList Bear Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ToDoList"
                        android:textColor="#203653"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLAN • ORGANIZE • ACHIEVE"
                        android:textColor="#71809A"
                        android:textSize="9sp"
                        android:letterSpacing="0.08" />

                </LinearLayout>

            </LinearLayout>

            <!-- HERO ILLUSTRATION -->
            <FrameLayout
                android:id="@+id/welcomeHeroPanel"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="20dp"
                android:background="#E5EEFF">

                <ImageView
                    android:layout_width="165dp"
                    android:layout_height="165dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_todo_note"
                    android:scaleType="fitCenter"
                    android:contentDescription="To do list illustration" />

            </FrameLayout>

            <!-- MAIN TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make Your Day&#10;More Productive."
                android:textColor="#203653"
                android:textSize="27sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="22dp" />

            <!-- DESCRIPTION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A little planning today makes a big difference tomorrow."
                android:textColor="#71809A"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="9dp" />

            <!-- FEATURE TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Everything you need"
                android:textColor="#203653"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp" />

            <!-- FEATURE CARDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- ORGANIZE -->
                <LinearLayout
                    android:id="@+id/featureCard1"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E5EEFF"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☑"
                        android:textSize="24sp"
                        android:textColor="#315D9B" />

                    <TextView
                        android:id="@+id/featureText1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Organize"
                        android:textColor="#315D9B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- MANAGE TIME -->
                <LinearLayout
                    android:id="@+id/featureCard2"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E5EEFF"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷"
                        android:textSize="24sp"
                        android:textColor="#315D9B" />

                    <TextView
                        android:id="@+id/featureText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage Time"
                        android:textColor="#315D9B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- STAY FOCUSED -->
                <LinearLayout
                    android:id="@+id/featureCard3"
                    android:layout_width="0dp"
                    android:layout_height="88dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E5EEFF"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textSize="24sp"
                        android:textColor="#315D9B" />

                    <TextView
                        android:id="@+id/featureText3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stay Focused"
                        android:textColor="#315D9B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- REMINDER CARD -->
            <LinearLayout
                android:id="@+id/cardWelcomeReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#E5EEFF"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✎  A LITTLE REMINDER"
                    android:textColor="#315D9B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvWelcomeReminderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Small steps, big progress."
                    android:textColor="#243F70"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="7dp" />

                <TextView
                    android:id="@+id/tvWelcomeReminderDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Every task you complete is one step closer to your goals."
                    android:textColor="#647A9B"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- GET STARTED BUTTON -->
    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#315D9B"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
