<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F3F5FA">

    <Button
        android:id="@+id/btnBackTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textAllCaps="false"
        android:textColor="#243F70"
        android:backgroundTint="#DCE7F8" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theme Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#243F70"
        android:layout_marginTop="25dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose your preferred appearance"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="25dp" />

    <RadioGroup
        android:id="@+id/radioGroupTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☀  Light Mode"
            android:textSize="17sp"
            android:textColor="#243F70"
            android:padding="15dp"
            android:background="#FFFFFF" />

        <RadioButton
            android:id="@+id/radioDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☾  Dark Mode"
            android:textSize="17sp"
            android:textColor="#243F70"
            android:padding="15dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF" />

    </RadioGroup>

    <Button
        android:id="@+id/btnSaveTheme"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save Theme"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#243F70"
        android:layout_marginTop="25dp" />

</LinearLayout>